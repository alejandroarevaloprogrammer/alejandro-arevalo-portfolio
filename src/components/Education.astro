
---
const courses = [
  {
    title: 'The Complete Web Development Bootcamp',
    details: 'Currently Studying · 62 hours',
  },
  {
    title: 'n8n + MCP: Automation and Intelligent AI Agents',
    details: 'Udemy · 2026 · 19 hours',
  },
  {
    title: 'Database Programming with PL/SQL',
    details: 'Oracle Academy · 2026',
  },
  {
    title: 'JavaScript Essentials 1 & 2',
    details: 'Cisco Networking Academy · 2025 · 90 hours',
  },
];
---

<section
  id="education"
  class="relative overflow-hidden border-t border-white/5 bg-slate-950 pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-32 lg:pb-24"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -right-64 top-1/2 h-[32rem] w-[32rem] -translate-y-1/2 rounded-full border border-blue-500/10"
    ></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <p
        class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-blue-400"
      >
        Education
      </p>

      <h2
        class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Training in web application development.
      </h2>
    </div>

    <!-- Vocational Education -->
    <div class="mt-16">
      <article
        class="rounded-3xl border border-white/10 bg-white/[0.03] p-7 sm:p-9"
      >
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-400"
        >
          Education
        </p>

        <h3 class="mt-5 text-xl font-semibold text-white sm:text-2xl">
          Higher Vocational Training in Web Application Development
        </h3>

        <p class="mt-3 text-base font-medium text-blue-400">
          Universitat Oberta de Catalunya (Spain)
        </p>

        <p class="mt-5 text-sm font-medium text-slate-400">
          2022 — Currently Studying
        </p>
      </article>
    </div>

    <!-- Courses -->
    <div class="mt-12">
      <div class="max-w-2xl">
        <p
          class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-blue-400"
        >
          Courses
        </p>

        <h3
          class="text-2xl font-semibold tracking-tight text-white sm:text-3xl"
        >
          Relevant development courses.
        </h3>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          courses.map((course) => (
            <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-7 sm:p-9">
              <h4 class="text-lg font-semibold leading-7 text-white">
                {course.title}
              </h4>

              <p class="mt-4 text-sm text-slate-400">
                {course.details}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
