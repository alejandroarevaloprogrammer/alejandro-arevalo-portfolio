---
const experience = {
  role: 'Web Development Intern',
  company: 'Fuerton, S.L.',
  period: 'November 2026 - Present',
  description:
    'Contributing to the development of browser extensions for Fuerton, a secure password and personal data management platform available on the web, Android, and iOS. Also working on an AI-powered chatbot to provide customer support and assist users of the application.',
};
---


<section
  id="experience"
  class="relative overflow-hidden border-t border-white/5 bg-slate-950 pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-32 lg:pb-24"
>
  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <p
        class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-blue-400"
      >
        Experience
      </p>

      <h2
        class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Professional experience.
      </h2>
    </div>

    <div class="mt-16 max-w-3xl">
      <article
        class="rounded-3xl border border-white/10 bg-white/[0.03] p-7 sm:p-9"
      >
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-400"
        >
          Internship
        </p>

        <h3 class="mt-5 text-xl font-semibold text-white sm:text-2xl">
          {experience.role}
        </h3>

        
        {
          experience.company && (
            <a
              href="https://www.fuerton.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1.5 text-base font-medium text-blue-400 transition-colors hover:text-blue-300 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-400"
              aria-label={`${experience.company} - Visit company website (opens in a new tab)`}
            >
              {experience.company}

              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          )
        }

        <p class="mt-5 text-sm font-medium text-slate-400">
          {experience.period}
        </p>

        <p class="mt-6 max-w-2xl text-base leading-7 text-slate-400">
          {experience.description}
        </p>
      </article>
    </div>
  </div>
</section>
