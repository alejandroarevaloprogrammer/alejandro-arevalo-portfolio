---
const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Education', href: '#education' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8"
  >
    <a
      href="#top"
      class="group flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-400"
      aria-label="Alejandro Arevalo Rojas - Home"
      data-home-link
    >
      <span
        class="flex size-10 items-center justify-center rounded-xl border border-blue-500/30 bg-blue-500/10 text-sm font-bold text-blue-400 transition group-hover:border-blue-400/60 group-hover:bg-blue-500/15"
        aria-hidden="true"
      >
        AR
      </span>

      <span
        class="hidden text-sm font-semibold tracking-wide text-white sm:block"
      >
        Alejandro Arevalo Rojas
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Main navigation">
      <ul class="flex items-center gap-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-medium text-slate-300 transition-colors hover:text-blue-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-400"
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href="https://github.com/alejandroarevaloprogrammer"
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-10 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
        aria-label="GitHub profile - opens in a new tab"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.96a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.58 5.06.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.83 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>

      <a
        href="https://www.linkedin.com/in/alejandro-ar%C3%A9valo-rojas-755335365/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-10 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
        aria-label="LinkedIn profile - opens in a new tab"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M6.94 8.5H3.56V19h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 13.02c0-3.16-1.69-4.63-3.94-4.63-1.82 0-2.63 1-3.08 1.7V8.5h-3.38V19h3.38v-5.2c0-1.37.26-2.7 1.96-2.7 1.67 0 1.69 1.56 1.69 2.79V19h3.37v-5.98Z" />
        </svg>
      </a>
    </div>

    <button
      type="button"
      class="flex size-10 items-center justify-center rounded-lg border border-white/10 text-slate-300 transition-colors hover:border-blue-400/40 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 lg:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        data-menu-icon
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>

      <svg
        viewBox="0 0 24 24"
        class="hidden size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        data-close-icon
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-slate-950/95 px-6 py-6 backdrop-blur-xl lg:hidden"
    data-mobile-menu
  >
    <nav aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-lg px-3 py-3 text-base font-medium text-slate-300 transition-colors hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                data-nav-link
                data-mobile-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-5 flex items-center gap-2 border-t border-white/10 pt-5">
      <a
        href="https://github.com/alejandroarevaloprogrammer"
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-10 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
        aria-label="GitHub profile - opens in a new tab"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2C6.48 2 2 6.58 2 12.24c0 4.53 2.87 8.37 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.96a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.35 4.8-4.58 5.06.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.83 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z" />
        </svg>
      </a>

      <a
        href="https://www.linkedin.com/in/alejandro-ar%C3%A9valo-rojas-755335365/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-10 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
        aria-label="LinkedIn profile - opens in a new tab"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M6.94 8.5H3.56V19h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 13.02c0-3.16-1.69-4.63-3.94-4.63-1.82 0-2.63 1-3.08 1.7V8.5h-3.38V19h3.38v-5.2c0-1.37.26-2.7 1.96-2.7 1.67 0 1.69 1.56 1.69 2.79V19h3.37v-5.98Z" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>('[data-menu-button]');

  const mobileMenu =
    document.querySelector<HTMLElement>('[data-mobile-menu]');

  const menuIcon =
    document.querySelector<SVGElement>('[data-menu-icon]');

  const closeIcon =
    document.querySelector<SVGElement>('[data-close-icon]');

  const mobileLinks =
    document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  const navLinks =
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const sectionIds = [
    'about',
    'education',
    'skills',
    'projects',
    'contact',
  ];

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  const closeMenu = () => {
    mobileMenu?.classList.add('hidden');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');

    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', 'Open navigation menu');
  };

  const openMenu = () => {
    mobileMenu?.classList.remove('hidden');
    menuIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');

    menuButton?.setAttribute('aria-expanded', 'true');
    menuButton?.setAttribute('aria-label', 'Close navigation menu');
  };

  const setActiveSection = (sectionId: string | null) => {
    navLinks.forEach((link) => {
      const isActive =
        sectionId !== null && link.getAttribute('href') === `#${sectionId}`;

      link.classList.toggle('text-blue-400', isActive);
      link.classList.toggle('text-slate-300', !isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const updateActiveSection = () => {
    const headerOffset = 80;
    const referencePoint = headerOffset + window.innerHeight * 0.25;

    if (window.scrollY < window.innerHeight * 0.35) {
      setActiveSection(null);
      return;
    }

    const isAtBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2;

    if (isAtBottom) {
      setActiveSection('contact');
      return;
    }

    let activeSection: string | null = null;

    sections.forEach((section) => {
      const rect = section.getBoundingClientRect();

      if (rect.top <= referencePoint && rect.bottom > referencePoint) {
        activeSection = section.id;
      }
    });

    setActiveSection(activeSection);
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = menuButton.getAttribute('aria-expanded') === 'true';

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMenu();
    }

    updateActiveSection();
  });

  window.addEventListener('scroll', updateActiveSection, { passive: true });

  updateActiveSection();
</script>