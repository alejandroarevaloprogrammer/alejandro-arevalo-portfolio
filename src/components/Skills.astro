---
import { skills } from '../data/skills';
import type { SkillCategory } from '../data/skills';

interface SkillGroup {
  title: SkillCategory;
  description: string;
}

const groups: readonly SkillGroup[] = [
  {
    title: 'Core',
    description: 'The foundation of my front-end work.',
  },
  {
    title: 'Frameworks',
    description: 'Modern tools for building structured web experiences.',
  },
  {
    title: 'Styling',
    description: 'Tools for creating responsive and consistent interfaces.',
  },
];
---

<section
  id="skills"
  class="relative overflow-hidden border-t border-white/5 bg-slate-950 pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-32 lg:pb-24"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -right-64 top-1/2 h-[36rem] w-[36rem] -translate-y-1/2 rounded-full bg-blue-600/5 blur-3xl"
    ></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-2xl">
      <p
        class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-blue-400"
      >
        Skills
      </p>

      <h2
        class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Technologies I use to build modern web experiences.
      </h2>

      <p class="mt-6 text-lg leading-8 text-slate-400">
        A focused front-end stack for building responsive, accessible and
        maintainable interfaces.
      </p>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      {
        groups.map((group) => {
          const groupSkills = skills.filter(
            (skill) => skill.category === group.title
          );

          return (
            <article
              class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.025] p-7 transition duration-300 hover:border-blue-400/30 hover:bg-white/[0.04]"
            >
              <div
                class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              />

              <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-400">
                {group.title}
              </h3>

              <p class="mt-3 min-h-12 text-sm leading-6 text-slate-400">
                {group.description}
              </p>

              <ul class="mt-8 flex flex-wrap gap-3">
                {
                  groupSkills.map((skill) => (
                    <li
                      class="rounded-lg border border-white/10 bg-slate-900/70 px-4 py-2.5 text-sm font-semibold text-slate-200"
                    >
                      {skill.name}
                    </li>
                  ))
                }
              </ul>
            </article>
          );
        })
      }
    </div>
  </div>
</section>